#!/bin/bash
# postinst script for drumee
#
# see: dh_installdeb(1)

set -e

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package
# Source debconf library.

case "$1" in
    configure)
    # The app runs under pm2 (started by /etc/init.d/drumee). pm2 is an npm global,
    # not a Debian package, so install it here if it isn't already present.
    if ! command -v pm2 >/dev/null 2>&1; then
        echo "Installing pm2 (process manager for the Drumee server)"
        npm install -g pm2 || echo "warning: pm2 install failed — install it manually (npm i -g pm2)" >&2
    fi
    if [ -f /etc/drumee/drumee.sh ]; then
        source /etc/drumee/drumee.sh
        if [ "$DRUMEE_SERVER_MAIN" == "" ]; then
            chmod 555 $DRUMEE_SERVER_HOME/main/offline/media/*.js
        else
            chmod 555 $DRUMEE_SERVER_MAIN/offline/media/*.js
        fi
    fi
    patch=/var/lib/drumee/postinstall/patch.sh
    if [ -x $patch ]; then
        $patch
    fi
    ;;

    reconfigure)
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
