        "fast_check": "public-api"
      }
    },
    "save_signup_info": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "save_usage_plan": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "save_tools": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "save_privacy": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "get_response": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "check_completion": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "mark_complete": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "get_countries": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "reset": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "update_profile": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "get_env": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "get_onboarding_invite_link": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "send_onboarding_invites": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      },
      "log": true
    },
    "get_activation_status": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      }
    },
    "send_workspace_invites": {
      "scope": "hub",
      "permission": {
        "src": "anonymous",
        "fast_check": "public-api"
      },
      "log": true,
      "doc": "Invite one or more email addresses to specific workspaces with a given privilege level",
      "params": {
        "emails": {
          "type": "array",
          "required": true,
          "doc": "List of email addresses to invite"
        },
        "workspaces": {
          "type": "array",
          "required": true,
          "doc": "List of workspace+role objects: [{hub_id, privilege}]. Privilege: 3=View, 6=Chat, 7=Edit, 15=Admin"
        }
      },
      "returns": {
        "success": { "type": "boolean" },
        "sent":    { "type": "number", "doc": "Number of invitation emails successfully sent" }
      }
    }
  },
  "modules": {
    "private": "service/onboarding",
    "public": "service/onboarding"
  }
}