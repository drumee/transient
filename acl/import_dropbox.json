{
  "services": {
    "list_files": {
      "doc": "List files/folders from Dropbox",
      "scope": "hub",
      "permission": { "src": "read" }
    },
    "import_file": {
      "doc": "Import a selected file from Dropbox",
      "scope": "hub",
      "permission": { "src": "write" }
    }
  },
  "modules": {
    "private": "service/import_dropbox",
    "public": "service/import_dropbox"
  }
}