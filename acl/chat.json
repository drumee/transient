{
  "services": {
    "acknowledge": {
      "doc": "Mark a message as read. Updates message acknowledgment status and notifies the message author via WebSocket that their message has been read.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "message_id": {
          "type": "string",
          "required": true,
          "description": "ID of the message to acknowledge/mark as read"
        }
      },
      "returns": {
        "type": "object",
        "description": "Updated message object with acknowledgment status",
        "properties": {
          "message_id": {
            "type": "string",
            "description": "Message ID"
          },
          "entity_id": {
            "type": "string",
            "description": "Chat entity/contact ID"
          },
          "message": {
            "type": "string",
            "description": "Message content"
          },
          "author_id": {
            "type": "string",
            "description": "Message author's user ID"
          },
          "ctime": {
            "type": "integer",
            "description": "Message creation timestamp"
          }
        }
      },
      "errors": []
    },

    "attachment": {
      "doc": "Get attachments for a specific message with pagination. Returns media files attached to a message, with 5 items per page. Each attachment includes full file metadata.",
      "scope": "hub",
      "permission": {
        "src": "read"
      },
      "params": {
        "message_id": {
          "type": "string",
          "required": true,
          "description": "ID of the message to get attachments for"
        },
        "page": {
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number for pagination (5 attachments per page)"
        }
      },
      "returns": {
        "type": "array",
        "description": "List of attachment file objects (5 per page)",
        "items": {
          "type": "object",
          "properties": {
            "nid": {
              "type": "string",
              "description": "File node ID"
            },
            "hub_id": {
              "type": "string",
              "description": "Hub ID where file is stored"
            },
            "file_name": {
              "type": "string",
              "description": "Name of the file"
            },
            "filesize": {
              "type": "integer",
              "description": "File size in bytes"
            },
            "extension": {
              "type": "string",
              "description": "File extension"
            },
            "category": {
              "type": "string",
              "description": "File category (image, video, document, etc.)"
            },
            "privilege": {
              "type": "integer",
              "description": "User's access privilege level"
            },
            "page": {
              "type": "integer",
              "description": "Current page number"
            }
          }
        }
      },
      "errors": []
    },

    "chat_rooms": {
      "doc": "List chat rooms with filtering and pagination. Returns paginated list of chat rooms with optional filtering by tag, keyword, flag, and status (active/archived).",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "tag_id": {
          "type": "string",
          "required": false,
          "default": "",
          "description": "Filter by tag ID"
        },
        "page": {
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number for pagination"
        },
        "key": {
          "type": "string",
          "required": false,
          "default": "",
          "description": "Search keyword to filter chat rooms"
        },
        "flag": {
          "type": "string",
          "required": false,
          "default": "",
          "description": "Additional flag filter"
        },
        "option": {
          "type": "string",
          "required": false,
          "default": "active",
          "description": "Room status filter (active or archived)"
        }
      },
      "returns": {
        "type": "array",
        "description": "Paginated list of chat rooms matching filters",
        "items": {
          "type": "object",
          "properties": {
            "entity_id": {
              "type": "string",
              "description": "Chat room entity ID"
            },
            "contact_id": {
              "type": "string",
              "description": "Contact ID"
            },
            "firstname": {
              "type": "string",
              "description": "Contact first name"
            },
            "lastname": {
              "type": "string",
              "description": "Contact last name"
            },
            "last_message": {
              "type": "string",
              "description": "Preview of last message"
            },
            "unread_count": {
              "type": "integer",
              "description": "Number of unread messages"
            },
            "last_activity": {
              "type": "integer",
              "description": "Timestamp of last activity"
            }
          }
        }
      },
      "errors": []
    },

    "chat_room_info": {
      "doc": "Get detailed information about a specific chat room. Returns complete metadata and current status of a chat room identified by key.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "key": {
          "type": "string",
          "required": true,
          "description": "Chat room identifier/key"
        }
      },
      "returns": {
        "type": "object",
        "description": "Chat room details",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Room entity ID"
          },
          "contact_id": {
            "type": "string",
            "description": "Associated contact ID"
          },
          "firstname": {
            "type": "string",
            "description": "Contact first name"
          },
          "lastname": {
            "type": "string",
            "description": "Contact last name"
          },
          "status": {
            "type": "string",
            "description": "Room status (active/archived)"
          },
          "unread_count": {
            "type": "integer",
            "description": "Unread message count"
          }
        }
      },
      "errors": []
    },

    "change_status": {
      "doc": "Change chat room status (archive or unarchive). Archives or restores a chat conversation. Triggers WebSocket notification to update UI across all user sessions.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "entity_id": {
          "type": "string",
          "required": true,
          "description": "Chat entity/contact ID to change status for"
        },
        "status": {
          "type": "string",
          "required": true,
          "description": "New status: 'archived' or 'active'"
        }
      },
      "returns": {
        "type": "object",
        "description": "Updated chat room status",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Chat entity ID"
          },
          "status": {
            "type": "string",
            "description": "New status (archived/active)"
          }
        }
      },
      "errors": [
        {
          "code": "INVALID_STATUS0",
          "message": "Status must be 'archived' or 'active'",
          "returns": {
            "status": "INVALID_STATUS0"
          }
        }
      ]
    },

    "contact_rooms": {
      "doc": "List chat rooms filtered by contacts. Returns chat rooms specifically for direct contact conversations (not group chats), with optional tag and keyword filtering.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "tag_id": {
          "type": "string",
          "required": false,
          "default": "",
          "description": "Filter by contact tag ID"
        },
        "page": {
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number for pagination"
        },
        "key": {
          "type": "string",
          "required": false,
          "default": "",
          "description": "Search keyword to filter rooms"
        }
      },
      "returns": {
        "type": "array",
        "description": "Paginated list of contact chat rooms",
        "items": {
          "type": "object",
          "properties": {
            "entity_id": {
              "type": "string",
              "description": "Contact entity ID"
            },
            "contact_id": {
              "type": "string",
              "description": "Contact ID"
            },
            "firstname": {
              "type": "string",
              "description": "Contact first name"
            },
            "lastname": {
              "type": "string",
              "description": "Contact last name"
            },
            "last_message": {
              "type": "string",
              "description": "Last message preview"
            },
            "unread_count": {
              "type": "integer",
              "description": "Unread messages count"
            }
          }
        }
      },
      "errors": []
    },

    "count_all": {
      "doc": "Get total unread message count across all chat rooms. Returns aggregate count of unread messages from all conversations.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {},
      "returns": {
        "type": "object",
        "description": "Aggregate unread count",
        "properties": {
          "total_unread": {
            "type": "integer",
            "description": "Total number of unread messages across all chats",
            "example": 42
          }
        }
      },
      "errors": []
    },

    "delete": {
      "doc": "Delete messages from chat. Can delete for self only ('me') or for both parties ('all'). Removes message content and attachments. Option 'all' requires user to be the message author.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "option": {
          "type": "string",
          "required": true,
          "description": "Delete scope: 'me' (hide from self) or 'all' (delete for everyone, requires authorship)"
        },
        "messages": {
          "type": "array",
          "required": true,
          "description": "Array of message IDs to delete",
          "items": {
            "type": "string",
            "description": "Message ID"
          }
        }
      },
      "returns": {
        "type": "array",
        "description": "List of deleted messages with status",
        "items": {
          "type": "object",
          "properties": {
            "message_id": {
              "type": "string",
              "description": "Deleted message ID"
            },
            "entity_id": {
              "type": "string",
              "description": "Chat entity ID"
            },
            "delete_status": {
              "type": "string",
              "description": "Deletion status"
            }
          }
        }
      },
      "errors": [
        {
          "code": "INVALID_OPTION",
          "message": "Option must be 'me' or 'all'",
          "returns": {
            "status": "INVALID_OPTION"
          }
        },
        {
          "code": "INVALID_MESSAGES",
          "message": "One or more message IDs do not exist",
          "returns": {
            "status": "INVALID_MESSAGES"
          }
        },
        {
          "code": "INVALID_OPTION",
          "message": "Cannot delete 'all' - user is not the message author",
          "returns": {
            "status": "INVALID_OPTION"
          }
        }
      ]
    },

    "forward": {
      "doc": "Forward messages to multiple recipients. Takes existing messages and sends copies to specified entities. Preserves original message content and attachments. Supports bulk forwarding.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "entities": {
          "type": "array",
          "required": true,
          "description": "Array of entity IDs to forward messages to",
          "items": {
            "type": "string",
            "description": "Recipient entity ID"
          }
        },
        "nodes": {
          "type": "object",
          "required": true,
          "description": "Message nodes to forward (contains message IDs and metadata)"
        }
      },
      "returns": {
        "type": "array",
        "description": "List of forwarded messages sent to each recipient",
        "items": {
          "type": "object",
          "properties": {
            "message_id": {
              "type": "string",
              "description": "New message ID (copy)"
            },
            "entity_id": {
              "type": "string",
              "description": "Recipient entity ID"
            },
            "forward_message_id": {
              "type": "string",
              "description": "Original message ID that was forwarded"
            },
            "author_id": {
              "type": "string",
              "description": "Forward sender's user ID"
            },
            "is_attachment": {
              "type": "integer",
              "description": "1 if message has attachments, 0 otherwise"
            }
          }
        }
      },
      "errors": []
    },

    "messages": {
      "doc": "Get paginated message list for a chat conversation. Returns messages with entity info, thread details, and attachment indicators. Automatically marks messages as read and notifies authors via WebSocket.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "entity_id": {
          "type": "string",
          "required": true,
          "description": "Chat entity/contact ID to get messages from"
        },
        "page": {
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number for pagination"
        }
      },
      "returns": {
        "type": "array",
        "description": "Paginated list of messages with full context",
        "items": {
          "type": "object",
          "properties": {
            "message_id": {
              "type": "string",
              "description": "Message ID"
            },
            "entity_id": {
              "type": "string",
              "description": "Message entity ID"
            },
            "message": {
              "type": "string",
              "description": "Message content"
            },
            "author_id": {
              "type": "string",
              "description": "Message author's user ID"
            },
            "ctime": {
              "type": "integer",
              "description": "Message creation timestamp"
            },
            "is_attachment": {
              "type": "integer",
              "description": "1 if has attachments, 0 otherwise"
            },
            "entity": {
              "type": "object",
              "description": "Message author entity information"
            },
            "thread": {
              "type": "object",
              "description": "Thread/reply context (if message is a reply)"
            }
          }
        }
      },
      "errors": []
    },

    "post": {
      "doc": "Send a message in a chat. Creates and delivers a message to a contact with optional attachments and thread reply. Validates contact, attachments, and thread. Moves attachments to permanent storage and distributes message to both parties via WebSocket.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "entity_id": {
          "type": "string",
          "required": true,
          "description": "Recipient entity/contact ID"
        },
        "message": {
          "type": "string",
          "required": false,
          "default": "",
          "description": "Message text content"
        },
        "thread_id": {
          "type": "string",
          "required": false,
          "description": "ID of message being replied to (for threaded conversations)"
        },
        "attachment": {
          "type": "array",
          "required": false,
          "default": [],
          "description": "Array of file node IDs to attach",
          "items": {
            "type": "string",
            "description": "File node ID (nid)"
          }
        }
      },
      "returns": {
        "type": "array",
        "description": "Array containing message objects sent to sender and recipient",
        "items": {
          "type": "object",
          "properties": {
            "message_id": {
              "type": "string",
              "description": "Unique message ID"
            },
            "entity_id": {
              "type": "string",
              "description": "Chat entity ID"
            },
            "message": {
              "type": "string",
              "description": "Message content"
            },
            "author_id": {
              "type": "string",
              "description": "Message author user ID"
            },
            "to_id": {
              "type": "string",
              "description": "Recipient user ID"
            },
            "is_attachment": {
              "type": "integer",
              "description": "1 if has attachments, 0 otherwise"
            },
            "entity": {
              "type": "object",
              "description": "Contact entity information"
            },
            "thread": {
              "type": "object",
              "description": "Thread context (if reply)"
            },
            "room": {
              "type": "integer",
              "description": "Unread count for this room"
            },
            "total": {
              "type": "integer",
              "description": "Total unread messages"
            },
            "echoId": {
              "type": "string",
              "description": "Echo ID from client request"
            }
          }
        }
      },
      "errors": [
        {
          "code": "INVALID_CONTACT",
          "message": "Contact does not exist or is invalid",
          "returns": {
            "status": "INVALID_CONTACT"
          }
        },
        {
          "code": "INVALID_ATTACHMENT",
          "message": "One or more attachments are invalid or inaccessible",
          "returns": {
            "status": "INVALID_ATTACHMENT"
          }
        },
        {
          "code": "INVALID_THREAD",
          "message": "Thread ID does not exist",
          "returns": {
            "status": "INVALID_THREAD"
          }
        }
      ]
    },

    "share_rooms": {
      "doc": "List group/shared chat rooms. Returns chat rooms for group conversations (not direct contact chats), with optional keyword filtering and pagination.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "page": {
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number for pagination"
        },
        "key": {
          "type": "string",
          "required": false,
          "default": "",
          "description": "Search keyword to filter group rooms"
        }
      },
      "returns": {
        "type": "array",
        "description": "Paginated list of group chat rooms",
        "items": {
          "type": "object",
          "properties": {
            "entity_id": {
              "type": "string",
              "description": "Group entity ID"
            },
            "group_name": {
              "type": "string",
              "description": "Name of the group"
            },
            "last_message": {
              "type": "string",
              "description": "Last message preview"
            },
            "unread_count": {
              "type": "integer",
              "description": "Unread messages count"
            },
            "member_count": {
              "type": "integer",
              "description": "Number of group members"
            }
          }
        }
      },
      "errors": []
    },

    "tag_chat_count": {
      "doc": "Get chat count for a specific tag. Returns the number of chat rooms associated with a contact tag.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "params": {
        "tag_id": {
          "type": "string",
          "required": true,
          "description": "Tag ID to count chats for"
        }
      },
      "returns": {
        "type": "array",
        "description": "List of chat counts by tag",
        "items": {
          "type": "object",
          "properties": {
            "tag_id": {
              "type": "string",
              "description": "Tag ID"
            },
            "tag_name": {
              "type": "string",
              "description": "Tag name"
            },
            "chat_count": {
              "type": "integer",
              "description": "Number of chats with this tag"
            }
          }
        }
      },
      "errors": []
    },

    "to_read": {
      "doc": "Get number of unread message pages for a contact. Returns how many pages of unread messages exist in a conversation. Used for pagination UI indicators.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "method": "pages_to_read",
      "params": {
        "entity_id": {
          "type": "string",
          "required": true,
          "description": "Contact entity ID to check unread pages for"
        }
      },
      "returns": {
        "type": "object",
        "description": "Unread pages count",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "Contact entity ID"
          },
          "pages_to_read": {
            "type": "integer",
            "description": "Number of pages containing unread messages",
            "example": 3
          }
        }
      },
      "errors": [
        {
          "code": "INVALID_CONTACT",
          "message": "Contact does not exist or is invalid",
          "returns": {
            "status": "INVALID_CONTACT"
          }
        }
      ]
    },

    "upload_remove": {
      "doc": "Remove an uploaded attachment before sending. Deletes a file from chat upload directory. Only works on files in /__chat__/__upload__/ path. File must be owned by user and cannot be a folder or hub.",
      "scope": "hub",
      "permission": {
        "src": "write"
      },
      "method": "remove_attachment",
      "params": {
        "nid": {
          "type": "string",
          "required": true,
          "description": "Node ID of the attachment file to remove"
        }
      },
      "returns": {
        "type": "object",
        "description": "Deleted file information",
        "properties": {
          "nid": {
            "type": "string",
            "description": "Deleted file node ID"
          },
          "file_name": {
            "type": "string",
            "description": "Name of deleted file"
          },
          "filesize": {
            "type": "integer",
            "description": "Size of deleted file"
          },
          "ftype": {
            "type": "string",
            "description": "File type"
          }
        }
      },
      "errors": [
        {
          "code": "INVALID_ATTACHMENT",
          "message": "File does not exist",
          "returns": {
            "status": "INVALID_ATTACHMENT"
          }
        },
        {
          "code": "INVALID_ATTACHMENT",
          "message": "File is not in chat upload directory (/__chat__/__upload__/)",
          "returns": {
            "status": "INVALID_ATTACHMENT"
          }
        },
        {
          "code": "INVALID_ATTACHMENT",
          "message": "Cannot delete folders or hubs",
          "returns": {
            "status": "INVALID_ATTACHMENT"
          }
        }
      ]
    }
  },

  "modules": {
    "private": "service/private/chat"
  }
}