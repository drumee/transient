#!/bin/sh
# postinst script for drumee-infra
#
# see: dh_installdeb(1)

set -e

# Source debconf FIRST, before any argument handling: confmodule may re-exec this
# script to connect to the debconf frontend, and doing that after `case "$1"`
# would lose the action argument ("postinst called with unknown argument ''").
. /usr/share/debconf/confmodule

# summary of how this script can be called:
#        * <postinst> `configure' <most-recently-configured-version>
#        * <old-postinst> `abort-upgrade' <new version>
#        * <conflictor's-postinst> `abort-remove' `in-favour' <package>
#          <new-version>
#        * <postinst> `abort-remove'
#        * <deconfigured's-postinst> `abort-deconfigure' `in-favour'
#          <failed-install-package> <version> `removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package

# Bridge the debconf answers (drumee-infra/*) into the DRUMEE_* environment
# variables that setup-infra/infra.js reads. Without this, infra.js gets an
# empty domain and silently exit(0)s, so `apt install drumee` (+ preseed) never
# configures. This mirrors the drumee-bootstrap wizard (setup/menu/install.sh).
bridge_debconf_env() {
    # confmodule is already sourced at the top of the script.
    db_get drumee-infra/description      || true; export DRUMEE_DESCRIPTION="$RET"
    db_get drumee-infra/domain           || true; export DRUMEE_DOMAIN_NAME="$RET"
    db_get drumee-infra/local_mode       || true; export LOCAL_MODE="$RET"
    db_get drumee-infra/service          || true; export SERVICES="$RET"
    db_get drumee-infra/admin_email      || true; export ADMIN_EMAIL="$RET"
    db_get drumee-infra/acme_email       || true; export ACME_EMAIL_ACCOUNT="$RET"
    db_get drumee-infra/db_dir           || true; export DRUMEE_DB_DIR="$RET"
    db_get drumee-infra/data_dir         || true; export DRUMEE_DATA_DIR="$RET"
    db_get drumee-infra/backup_location  || true; export BACKUP_LOCATION="$RET"
    db_get drumee-infra/exchange_location|| true; export EXCHANGE_LOCATION="$RET"
    # Public addresses. The select answer *is* the address unless it reads
    # "other", in which case the free-text answer carries it — same shape as the
    # wizard (setup/menu/install.sh). render.mjs preseeds the pair only when
    # drumee.yaml pins an explicit address; with `network.ip4: auto` nothing is
    # preseeded, both stay empty, and infra.js behaves as before. Without this,
    # a pinned address reached debconf and was dropped here, leaving
    # data.public_ip4 empty so infra.js skipped the whole public branch (nginx
    # 01-public.conf, the BIND public/reverse zones, and postfix/opendkim).
    # No db_get inside $(...) — confmodule speaks the debconf protocol over
    # stdout, and a command substitution would capture it instead.
    db_get drumee-infra/ip4 || true; PUBLIC_IP4="$RET"
    if [ "$PUBLIC_IP4" = "other" ]; then db_get drumee-infra/public_ip4 || true; PUBLIC_IP4="$RET"; fi
    export PUBLIC_IP4
    db_get drumee-infra/ip6 || true; PUBLIC_IP6="$RET"
    if [ "$PUBLIC_IP6" = "other" ]; then db_get drumee-infra/public_ip6 || true; PUBLIC_IP6="$RET"; fi
    export PUBLIC_IP6
    OWN_SSL=""
    db_get drumee-infra/own_ssl || true
    if [ "$RET" = "true" ]; then db_get drumee-infra/own_ssl_path || true; OWN_SSL="$RET"; fi
    export OWN_SSL
    # WireGuard peer coordination. Defaults mirror debian/templates so an
    # instance preseeded without the wireguard/* keys stays disabled rather
    # than half-configured.
    db_get drumee-infra/wireguard_enabled        || true; export WIREGUARD_ENABLED="${RET:-false}"
    db_get drumee-infra/wireguard_coordinator    || true; export WIREGUARD_COORDINATOR="${RET:-coord.drumee.tech}"
    db_get drumee-infra/wireguard_listen_port    || true; export WIREGUARD_LISTEN_PORT="${RET:-51820}"
    db_get drumee-infra/wireguard_reflector_port || true; export WIREGUARD_REFLECTOR_PORT="${RET:-51821}"
    # Release the debconf channel before the long-running installer.
    db_stop
}

# Write /etc/drumee/conf.d/wireguard.json and wire up the units. The file is
# generated here rather than shipped in the package so dpkg never treats it as
# a conffile and never prompts on upgrade.
setup_wireguard() {
    conf_dir=/etc/drumee/conf.d
    mkdir -p "$conf_dir"
    cat > "$conf_dir/wireguard.json" <<EOF
{
  "enabled": ${WIREGUARD_ENABLED},
  "coordinator_host": "${WIREGUARD_COORDINATOR}",
  "reflector_port": ${WIREGUARD_REFLECTOR_PORT},
  "listen_port": ${WIREGUARD_LISTEN_PORT}
}
EOF
    chmod 0644 "$conf_dir/wireguard.json"

    if [ "$WIREGUARD_ENABLED" != "true" ]; then
        echo "WireGuard coordination disabled — units left inactive."
        deb-systemd-invoke stop drumee-wg-agent.service >/dev/null 2>&1 || true
        systemctl disable drumee-wg-agent.service     >/dev/null 2>&1 || true
        systemctl disable drumee-wg-bootstrap.service >/dev/null 2>&1 || true
        return 0
    fi

    # The agent uses the global WebSocket API, stable from Node 22. The package
    # only requires nodejs >= 20 for the rest of the stack, so check explicitly
    # and degrade with a clear message instead of a crash loop at boot.
    node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
    if [ "$node_major" -lt 22 ]; then
        echo "drumee-infra: WireGuard agent needs Node >= 22 (found $node_major)." >&2
        echo "  Coordination left disabled. Upgrade Node, then: dpkg-reconfigure drumee-infra" >&2
        sed -i 's/"enabled": true/"enabled": false/' "$conf_dir/wireguard.json"
        return 0
    fi

    echo "Enabling WireGuard peer coordination via ${WIREGUARD_COORDINATOR}"
    systemctl daemon-reload || true
    systemctl enable drumee-wg-bootstrap.service >/dev/null 2>&1 || true
    systemctl enable drumee-wg-agent.service     >/dev/null 2>&1 || true
    deb-systemd-invoke restart drumee-wg-bootstrap.service || true
    deb-systemd-invoke restart drumee-wg-agent.service     || true
}

case "$1" in
    configure)
    echo "Configuring Drumee Infrastructure"
    bridge_debconf_env
    if [ -z "$DRUMEE_DOMAIN_NAME" ]; then
        echo "drumee-infra: no domain configured (debconf drumee-infra/domain is empty)." >&2
        echo "  Preseed it first, e.g.: debconf-set-selections < install.conf  (from: render.mjs debconf)" >&2
        exit 1
    fi
    /var/lib/drumee/setup-infra/bin/install
    setup_wireguard
    ;;

    reconfigure)
    bridge_debconf_env
    node /var/lib/drumee/setup-infra/infra.js --force-install=1
    setup_wireguard
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
