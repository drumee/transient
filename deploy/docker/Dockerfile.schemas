# Drumee schemas-init image — run-once database initializer.
# Lean: just a MariaDB client + the factory templates + the init script. It does
# NOT run the Node patch engine (that assumes a local socket); it loads the
# data-free factory seed over TCP. See deploy/docker/schemas-init.sh.
#
# Build context is the schemas source repo (for templates/factory). The init
# script comes from a named build context:
#
#   docker buildx build -f deploy/docker/Dockerfile.schemas \
#     --build-context helpers=deploy/docker \
#     -t drumee/schemas:<tag> /path/to/schemas
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      mariadb-client ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Only the factory seed templates are needed (data-free schema + system accounts).
COPY templates/factory/ /factory/
COPY --from=helpers schemas-init.sh /usr/local/bin/schemas-init
RUN chmod +x /usr/local/bin/schemas-init

ENTRYPOINT ["schemas-init"]
