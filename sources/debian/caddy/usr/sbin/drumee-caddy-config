#!/bin/bash
# Render /etc/drumee/caddy/Caddyfile from /etc/drumee/conf.d/caddy.json.
#
# The JSON half of the contract is written by drumee-infra's postinst when
# tls_method=caddy (see infra/debian/postinst: setup_caddy). This script is the
# other half: it turns those answers into a Caddyfile, and is run by
# drumee-caddy.service before Caddy starts, so a `dpkg-reconfigure drumee-infra`
# followed by a restart is enough to apply a change.
set -euo pipefail

CONF="${DRUMEE_CADDY_CONF:-/etc/drumee/conf.d/caddy.json}"
OUT="${DRUMEE_CADDY_FILE:-/etc/drumee/caddy/Caddyfile}"

die() { printf '[drumee-caddy-config] ERROR: %s\n' "$*" >&2; exit 1; }

[ -f "$CONF" ] || die "missing $CONF — select tls_method=caddy (dpkg-reconfigure drumee-infra)"

# node comes with drumee-infra's dependencies; no JSON parser to install.
jget() { node -e "const c=require('$CONF');process.stdout.write(String(c.$1 ?? ''))"; }

enabled=$(jget enabled)
domain=$(jget domain)
provider=$(jget dns_provider)
acme_email=$(jget acme_email)
upstream=$(jget upstream_http_port)

[ "$enabled" = "true" ] || die "caddy is not the selected TLS method (enabled=false in $CONF)"
[ -n "$domain" ]        || die "no domain in $CONF"
[ -n "$provider" ]      || die "no dns_provider in $CONF"
[ -n "$upstream" ]      || upstream=8080

# Most caddy-dns modules take a single credential. Providers that need several
# (OVH wants an endpoint plus three keys) cannot be expressed that way, so the
# credentials file may define DRUMEE_CADDY_DNS_BLOCK with the full directive
# body instead — it is used verbatim when present.
if [ -n "${DRUMEE_CADDY_DNS_BLOCK:-}" ]; then
  dns_directive="$DRUMEE_CADDY_DNS_BLOCK"
else
  [ -n "${DRUMEE_CADDY_DNS_TOKEN:-}" ] \
    || echo "[drumee-caddy-config] warning: DRUMEE_CADDY_DNS_TOKEN is empty" >&2
  dns_directive="dns ${provider} {env.DRUMEE_CADDY_DNS_TOKEN}"
fi

install -d -m 0755 "$(dirname "$OUT")"

# The service surfaces Drumee requires certificates for, beyond the apex. Each
# one needs BOTH the bare name and its own wildcard: a wildcard matches exactly
# one label, so *.<domain> does not cover anything under vendors.<domain>.
# Keep in step with setup-infra's nginx vhosts and BIND zone.
SUBDOMAINS="${DRUMEE_SUBDOMAINS:-jit vendors}"
names="${domain}, *.${domain}"
for sub in $SUBDOMAINS; do
  names="${names}, ${sub}.${domain}, *.${sub}.${domain}"
done

# One site block listing every name, so Caddy requests ONE certificate carrying
# all of them as SANs — which is what lets the exporter satisfy the apex and every
# subdomain from a single file.
cat > "$OUT" <<EOF
# Generated by drumee-caddy-config from ${CONF} — do not edit by hand.
{
	email ${acme_email}
}

${names} {
	tls {
		${dns_directive}
	}

	# nginx keeps serving the application; drumee-infra moved it off 80/443 so
	# Caddy could take them (DRUMEE_HTTP_PORT).
	reverse_proxy 127.0.0.1:${upstream}
}
EOF
chmod 0644 "$OUT"

# Adapt the result with the real binary before anything depends on it. Not
# belt-and-braces: the single-token form above is only valid for providers whose
# module takes one positional argument. OVH (endpoint + three keys) rejects it, so
# without this check the service would crash-loop at start with the error buried
# in the journal instead of being reported here.
CADDY_BIN="${DRUMEE_CADDY_BIN:-/usr/sbin/drumee-caddy}"
if [ -x "$CADDY_BIN" ]; then
  if ! adapt_err=$("$CADDY_BIN" adapt --config "$OUT" 2>&1 >/dev/null); then
    echo "[drumee-caddy-config] ERROR: the generated Caddyfile is not valid:" >&2
    printf '  %s\n' "$adapt_err" >&2
    if [ -z "${DRUMEE_CADDY_DNS_BLOCK:-}" ]; then
      echo "  The '${provider}' module probably needs more than a single token." >&2
      echo "  Put the whole directive in /etc/drumee/credential/caddy-dns.env, e.g.:" >&2
      echo "    export DRUMEE_CADDY_DNS_BLOCK='dns ${provider} {" >&2
      echo "      endpoint ovh-eu" >&2
      echo "      application_key ...  application_secret ...  consumer_key ..." >&2
      echo "    }'" >&2
      echo "  See /usr/share/doc/drumee-caddy/README.md." >&2
    fi
    exit 1
  fi
fi

echo "[drumee-caddy-config] wrote $OUT for ${domain} via dns/${provider}"
