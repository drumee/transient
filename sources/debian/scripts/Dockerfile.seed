# Drumee seed-builder image — a self-contained toolbox that produces schemas'
# var/tmp/drumee/seeds.tgz offline (the mariabackup snapshot the native .deb
# install restores). Built from source, NOT from the server-pod image: the app
# code + @drumee node_modules are bind-mounted at runtime (see scripts/build-seed.sh),
# so this image only carries the tools + the reused helper scripts.
#
#   docker build -f scripts/Dockerfile.seed \
#     --build-context helpers=deploy/docker -t drumee/seed:local scripts
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg \
      mariadb-server mariadb-client mariadb-backup \
      redis-server \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
         | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
         > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Reused, unmodified container assets from the compose channel (helpers context =
# deploy/docker): the DB initializer, the populate driver, and the populate config
# driver. Kept identical to the compose channel so the seed is built by the same
# vetted code paths. seed-entrypoint.sh is seed-specific and lives here in scripts/.
COPY --from=helpers schemas-init.sh        /usr/local/bin/schemas-init
COPY --from=helpers populate-entrypoint.sh /usr/local/bin/drumee-populate
COPY --from=helpers container-populate.js  /usr/local/lib/drumee/container-populate.js
COPY seed-entrypoint.sh                    /usr/local/bin/seed-entrypoint
RUN chmod +x /usr/local/bin/schemas-init /usr/local/bin/drumee-populate \
             /usr/local/bin/seed-entrypoint \
    && mkdir -p /run/mysqld && chown mysql:mysql /run/mysqld

ENTRYPOINT ["seed-entrypoint"]
